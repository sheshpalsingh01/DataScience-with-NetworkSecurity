# Floci's S3-compatible API endpoint
FLOCI_S3_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Use an existing Floci bucket or choose a new bucket name.
TRAINING_BUCKET_NAME=my-first-bucket

# These model files were uploaded to the bucket root.
MODEL_S3_PREFIX=
